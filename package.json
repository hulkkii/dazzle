{
  "name": "react-dazzle",
  "version": "1.4.0",
  "description": "The simple yet flexible dashbording solution for React",
  "license": "MIT",
  "main": "dist/lib.js",
  "style": "lib/style/style.css",
  "scripts": {
    "prebuild": "npm run clean",
    "build": "cross-env NODE_ENV=production webpack --mode production --config webpack.config.prod.js",
    "clean": "rimraf dist coverage",
    "start": "cross-env NODE_ENV=production node server/node-server.js",
    "dev": "cross-env NODE_ENV=development webpack-dev-server --mode development --hot --progress",
    "lint": "npm run lint-js",
    "lint-js": "eslint --fix --ext .js,.jsx .",
    "test": "npx mocha ./test/entry.js './test/**/*.spec.js' --require @babel/register",
    "test:watch": "npx mocha ./test/entry.js './test/**/*.spec.js' --require @babel/register --watch",
    "cover": "nyc mocha ./test/entry.js './test/**/*.spec.js' --require @babel/register",
    "report-cover": "nyc mocha ./test/entry.js './test/**/*.spec.js' --require @babel/register && codecov",
    "semantic-release": "semantic-release pre && npm publish && semantic-release post",
    "commit": "git-cz"
  },
  "keywords": [
    "react",
    "dashboard",
    "react-component",
    "widgets",
    "react-dazzle",
    "analytics-dashboard",
    "analytics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Raathigesh/dazzle.git"
  },
  "bugs": {
    "url": "https://github.com/Raathigesh/dazzle/issues"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/register": "^7.27.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@wojtekmaj/enzyme-adapter-react-17": "^0.8.0",
    "babel-loader": "^9.1.0",
    "babel-plugin-istanbul": "^6.1.1",
    "bootstrap": "^5.3.0",
    "chai": "^4.4.1",
    "commitizen": "^4.3.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.10.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "express": "^4.18.2",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.0",
    "http-proxy": "^1.18.1",
    "jsdom": "^24.0.0",
    "mocha": "^10.3.0",
    "nyc": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-loader": "^4.13.1",
    "react-modal": "^3.16.1",
    "rimraf": "^5.0.5",
    "semantic-release": "^23.0.0",
    "sinon": "^17.0.1",
    "source-map-loader": "^4.0.2",
    "style-loader": "^3.3.4",
    "stylelint": "^16.2.1",
    "url-loader": "^4.1.1",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-hot-middleware": "^2.25.4",
    "winston": "^3.11.0"
  },
  "dependencies": {
    "enzyme": "^3.11.0",
    "immutability-helper": "^3.1.1",
    "prop-types": "^15.8.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "czConfig": {
    "path": "node_modules/cz-conventional-changelog"
  }
}
